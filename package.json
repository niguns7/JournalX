{
  "name": "journalx",
  "version": "1.0.0",
  "private": true,
  "description": "Personal trading journal application",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @journalx/api --filter @journalx/web dev",
    "dev:api": "pnpm --filter @journalx/api dev",
    "dev:web": "pnpm --filter @journalx/web dev",
    "build": "pnpm --filter @journalx/domain build && pnpm --filter @journalx/db build && pnpm --filter @journalx/api-client build && pnpm --filter @journalx/api build && pnpm --filter @journalx/web build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "db:generate": "pnpm --filter @journalx/db db:generate",
    "db:migrate": "pnpm --filter @journalx/db db:migrate",
    "db:seed": "pnpm --filter @journalx/db db:seed",
    "db:fixtures": "pnpm --filter @journalx/db db:fixtures",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:benchmark": "pnpm --filter @journalx/db db:benchmark",
    "bench": "pnpm --filter @journalx/db db:benchmark",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "test": "pnpm --recursive run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "prettier": "^3.5.3",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
