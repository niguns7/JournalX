{
  "name": "@journalx/db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/migrate.ts src/seeds/seed.ts src/seeds/fixtures.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/bin/migrate.ts",
    "db:seed": "tsx src/bin/seed.ts",
    "db:fixtures": "tsx src/bin/fixtures.ts",
    "db:benchmark": "tsx src/bin/benchmark.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@journalx/domain": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@journalx/config": "workspace:*",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
