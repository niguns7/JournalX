# Database Configuration
POSTGRES_USER=journalx
POSTGRES_PASSWORD=journalx_secret
POSTGRES_DB=journalx
POSTGRES_PORT=5442
DATABASE_URL=postgresql://journalx:journalx_secret@127.0.0.1:5442/journalx

# API Configuration
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Storage Configuration
STORAGE_DIR=./storage/attachments
MAX_UPLOAD_SIZE_MB=10

# Default User Timezone Configuration
DEFAULT_JOURNAL_TIMEZONE=Asia/Kathmandu
DEFAULT_DISPLAY_TIMEZONE=Asia/Kathmandu

# Web Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
